{
 "format": "pai-contract/1",
 "name": "first-reply",
 "version": 2,
 "desc": "The first reply worker-base.md §0.3 asks for.",
 "source_prompt": "worker-base",
 "checks": [
  {
   "id": "files-read",
   "type": "section",
   "pattern": "读过|读了|files? read",
   "desc": "a 'files read' part"
  },
  {
   "id": "paths",
   "type": "regex",
   "pattern": "(?<![\\w/.-])(?:[\\w.@~-]+/)*[\\w-]+\\.(?:md|py|sh|json|txt|toml|go|ts)\\b",
   "min": 3,
   "desc": "at least 3 file paths (root files like README.md count)"
  },
  {
   "id": "decisions",
   "type": "section",
   "pattern": "决策|decision",
   "desc": "a part on answered / defaulted decisions"
  },
  {
   "id": "first-ids",
   "type": "ids",
   "pattern": "\\bR\\d+-[A-Z]{2,5}-\\d{3}\\b",
   "min": 5,
   "desc": "at least 5 item IDs"
  },
  {
   "id": "blocked",
   "type": "section",
   "pattern": "owner-only|阻塞|blocked",
   "desc": "a part on owner-only / blocked items"
  },
  {
   "id": "deps",
   "type": "section",
   "pattern": "依赖|depend|cross-lane|其他线",
   "desc": "a part on dependencies on other lanes"
  },
  {
   "id": "no-session-link",
   "type": "absent",
   "pattern": "claude\\.ai/(?:code/)?(?:session|chat)[_/]|chatgpt\\.com/c/",
   "desc": "no agent session link"
  }
 ],
 "jev": [
  {
   "id": "lists_files",
   "maps_to": "paths",
   "instructions": "The REPLY lists, by path, the specific files its author read before starting work."
  },
  {
   "id": "names_ids",
   "maps_to": "first-ids",
   "instructions": "The REPLY names at least five specific work item IDs (like R6-ABC-001) that its author will do first."
  }
 ]
}
